NEXTAUTH_URL=http://localhost:3000

# Required:
# NEXTAUTH_SECRET= # Linux: `openssl rand -hex 32` or go to https://generate-secret.now.sh/32

# API
API_URL=http://localhost:8080

# Shared key for the AlertLens backend, if that backend sets ALERTLENS_API_KEY.
# Must match it exactly. Deliberately NOT prefixed NEXT_PUBLIC_: middleware.ts
# attaches it server-side when proxying /backend/*, so it never reaches the
# browser. Leave unset when the backend is on localhost without a key.
# ALERTLENS_API_KEY=
# Auth
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_ISSUER=
# Pusher
PUSHER_HOST=localhost
PUSHER_PORT=6001
PUSHER_APP_KEY=keepappkey
# Logging
LOG_FORMAT=dev_terminal
