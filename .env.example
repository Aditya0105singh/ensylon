# Backend configuration. Copy to .env (gitignored) and fill in what you need.
# Every value here is optional: with none of them set, the backend runs the full
# demo on localhost and refuses requests from anywhere else.

# --- Authentication -------------------------------------------------------
# Shared key for the API. Unset, the backend serves loopback only and refuses
# every remote request, so a local demo needs no configuration and a deployed
# instance is not silently wide open. Set it for ANY deployment that is
# reachable over a network, and set the same value in the frontend's
# ALERTLENS_API_KEY so its server-side proxy can authenticate.
#   generate with: openssl rand -hex 32
# ALERTLENS_API_KEY=

# --- CORS -----------------------------------------------------------------
# Browser origins allowed to call the API cross-origin, comma separated.
# Defaults to localhost:3000/3001. The frontend does not need an entry here:
# it proxies through its own server, not the browser.
# ALERTLENS_ALLOWED_ORIGINS=https://alertlens.example.com

# --- Limits ---------------------------------------------------------------
# Defaults: 2 MiB body, 300 requests/min per client, 15/min on LLM-backed
# routes. Local clients are exempt from rate limiting unless FORCE is set.
# ALERTLENS_MAX_BODY_BYTES=2097152
# ALERTLENS_RATE_LIMIT=300
# ALERTLENS_EXPENSIVE_RATE_LIMIT=15
# ALERTLENS_RATE_LIMIT_FORCE=

# --- LLM narrative (optional) ---------------------------------------------
# Without a key, drafts and assistant answers use the deterministic template.
# Both providers have a free tier; Cerebras is tried first.
# CEREBRAS_API_KEY=
# GROQ_API_KEY=

# --- Ensylon AIOps Challenge ----------------------------------------------
# Claude API key for ticket drafting (C5). Put the real value ONLY in .env
# (gitignored) or your shell environment - a committed key counts as leaked.
# Without it, drafts use the deterministic template and everything else works.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=medium
# CLAUDE_DRAFTING=1            # 0 disables Claude even when a key is set

# Signal streams. Defaults are the challenge endpoints.
# NEXUS_BASE_URL=https://logs.nonprod.nexus.ensylon.com
# NEXUS_LIVE=1                 # 0: do not connect (air-gapped dev)
# STREAM_TICK_SECONDS=2        # micro-batch interval
# TICKETS_DIR=output/tickets   # where approved tickets are written
# CLAUDE_TIMEOUT_SECONDS=90    # per-call timeout on the drafting request

# Offline mode: mounts generated-scenario and push-ingest routes for tests and
# development. Never enable it for the evaluated run - the three streams must
# be the only input.
# AIOPS_OFFLINE_DEMO=0

# --- Recording, resume and replay (see README "Recording, resume and replay") --
# Every handled event, already redacted, is recorded to RECORDINGS_DIR so a
# restart can rebuild state and resume each stream from its Last-Event-ID
# without losing or double-counting anything.
# NEXUS_RECORD=1               # 0: do not record this session
# NEXUS_RESUME=1               # 0: always start cold, ignore prior recordings
# RECORDINGS_DIR=recordings
# RESUME_MAX_AGE_HOURS=12      # a recording older than this is not resumed from
#
# Replay a recording instead of connecting to the real streams - a demo aid
# when the simulator is quiet. The UI shows a REPLAY banner instead of "Streams
# live". Never enable this for the evaluated run.
# NEXUS_REPLAY=                # a recording path, or `latest`
# REPLAY_SPEED=1               # playback speed multiplier
# REPLAY_FROM=busiest          # `busiest` | `start` | an ISO timestamp
# REPLAY_MAX_GAP_SECONDS=6     # long silences in the recording are shortened to this

# --- Notifications (optional) ----------------------------------------------
# Without this, notifications go to an in-memory mock transport (visible on
# the Settings page) instead of a real endpoint.
# ALERT_WEBHOOK_URL=
