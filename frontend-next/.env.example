# AlertLens UI (KeepHQ-based frontend)
# Copy to .env.local for development, or set these in your host's env for prod.

# Public URL of THIS frontend. Must match where it's actually served.
NEXTAUTH_URL=http://localhost:3001

# Session signing secret. Generate a fresh one per environment:
#   openssl rand -hex 32
NEXTAUTH_SECRET=replace-me

# AlertLens FastAPI backend.
# The browser calls /backend/*; middleware.ts rewrites those to this origin.
# Local:      http://127.0.0.1:8000
# Deployed:   https://<your-backend>.onrender.com
API_URL=http://127.0.0.1:8000

# AlertLens's backend is open, so the UI runs with no login.
AUTH_TYPE=NO_AUTH

# KeepHQ integrations AlertLens does not use.
PUSHER_DISABLED=true
POSTHOG_DISABLED=true
SENTRY_DISABLED=true

# "/" is AlertLens's own overview page, not Keep's redirect to /incidents.
DISABLE_REDIRECTS=true

LOG_FORMAT=dev_terminal
